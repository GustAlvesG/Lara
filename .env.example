APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------------
# FTP das câmeras da portaria — fotos do SIV (busca de placa)
#
# FTP_ROOT é a pasta onde as câmeras gravam, uma subpasta por placa. A foto é
# copiada para public/storage/img_car na primeira busca e servida de lá.
# O arquivamento de documentos assinados usa este mesmo servidor e conta.
# Guia: docs/funcionalidades/estacionamento-placas.md
#
# NUNCA preencha valores reais aqui — este arquivo vai para o repositório.
# ---------------------------------------------------------------------------
FTP_HOST=
FTP_PORT=21
FTP_USERNAME=
FTP_PASSWORD=
FTP_ROOT=Lara/lpr
# Segundos de espera pela conexão; a busca fica presa por esse tempo se o FTP cair.
# FTP_TIMEOUT=10
# FTP_PASSIVE=true

VITE_APP_NAME="${APP_NAME}"

API_TOKEN=#API_TOKEN#

JWT_SECRET=#JWT_SECRET#

WHATSAPP_API_URL=#
WHATSAPP_PHONE_ID=#
WHATSAPP_TOKEN=#
WHATSAPP_VERIFY_TOKEN=#

# ---------------------------------------------------------------------------
# Poli Digital — ENVIO de mensagens (o webhook de entrada não usa nada disto)
#
# Com POLI_ENABLED=false o acesso do Uber é liberado e registrado como sempre,
# só não sai o aviso no WhatsApp. Exige worker de fila rodando: o envio é um
# Job (SendPoliTextMessage), por causa do teto de requisições da conta.
# Teste real, com confirmação: php artisan poli:teste-envio <telefone>
#
# NUNCA preencha valores reais aqui — este arquivo vai para o repositório.
# ---------------------------------------------------------------------------
POLI_ENABLED=false
POLI_API_TOKEN=
POLI_ACCOUNT_UUID=
POLI_CHANNEL_UUID=
# POLI_RATE_LIMIT_PER_MINUTE=50
# Depois do aviso de chegada do Uber a Lara cuida do atendimento: sem humano
# nele, passa para O Lara (modo on) ou encerra.
# POLI_UBER_ARRIVAL_CLOSE=true

# Bot de atendimento na Lara (ver config/poli.php, bloco `bot`). O Lara é a
# própria Lara: toda conversa atribuída a ele é respondida.
#   off    = a Lara não fala nem nas conversas do O Lara (chave de emergência)
#   shadow = piloto: Uber e bot da Poli como hoje; a Lara responde de verdade
#            só nas conversas do O Lara (opção "Funcionalidade Teste")
#   on     = como shadow, e o aviso do Uber passa a conversa para O Lara
# Fluxos: php artisan poli:bot-fluxos --instalar · teste: php artisan poli:bot-simular oi
POLI_BOT_MODE=off
POLI_BOT_USER_UUID=a2d4c71c-7249-4fd2-9770-8ccc30bb97bd
# Piloto (shadow): números de teste com DDI, separados por vírgula. Os demais
# que chegarem ao O Lara vão para a Secretaria (ou POLI_BOT_TEST_OTHERS_TEAM).
POLI_BOT_TEST_CONTACTS=
POLI_BOT_TEST_OTHERS_TEAM=
# Fim do fluxo: minutos sem mensagem até a Lara encerrar o atendimento.
POLI_BOT_ENCERRAR_APOS_MIN=10
# Até quantos minutos depois do encerramento a mensagem presa é resgatada.
POLI_BOT_RESGATE_MIN=30
# Time que recebe quem pede atendente ou esgota as tentativas.
POLI_BOT_FALLBACK_TEAM=
# Rajada: mensagem que não responde à pergunta, escrita até N segundos depois
# da última fala do bot (ou antes dela), não recebe correção nem menu de novo.
POLI_BOT_RAJADA_S=5

# Lara — agente de IA interno. Sem LARA_BASE_URL o chat aparece desativado,
# então dá pra subir o código em produção antes de o endereço estar liberado.
# O endereço da VM não vai para o repositório: preencher só no .env do servidor.
LARA_ENABLED=false
LARA_BASE_URL=
LARA_TIMEOUT=60

# A diretoria dos contratos de freelancer (nome, e-mail dos códigos e imagem da
# assinatura) é cadastrada pela gerência em Serviços / Contratos → Diretoria.
# FREELANCER_DIRECTOR_NAME / FREELANCER_DIRECTOR_EMAIL só são lidas uma vez, pela
# migration create_freelancer_directors_table, para importar o destinatário
# antigo. Depois disso podem sair do .env.

# ---------------------------------------------------------------------------
# Sicoob — Pix Pagamentos (ENVIA DINHEIRO REAL)
#
# Com SICOOB_PIX_ENABLED=false o "Dar baixa" do financeiro continua sendo uma
# marcação manual, sem tocar no banco. Ligue só depois de conferir todo o
# restante. Guia completo: docs/funcionalidades/pix-sicoob.md
#
# NUNCA preencha valores reais aqui — este arquivo vai para o repositório.
# ---------------------------------------------------------------------------
SICOOB_PIX_ENABLED=false
SICOOB_ENVIRONMENT=sandbox
SICOOB_CLIENT_ID=

# Certificado ICP Brasil em PEM (converta o .pfx uma vez; ver documentação).
# Os arquivos ficam em storage/certificates/, que está no .gitignore.
SICOOB_CERT_PATH=
SICOOB_CERT_KEY_PATH=
SICOOB_CERT_KEY_PASSWORD=

# Sandbox: https://sandbox.sicoob.com.br/sicoob/sandbox/pix-pagamentos/v2
# Produção: https://api.sicoob.com.br/pix-pagamentos/v2
SICOOB_PIX_BASE_URL=https://sandbox.sicoob.com.br/sicoob/sandbox/pix-pagamentos/v2
SICOOB_TOKEN_URL=https://auth.sicoob.com.br/auth/realms/cooperado/protocol/openid-connect/token

# Teto por transferência, em reais. Última barreira antes de o dinheiro sair.
SICOOB_PIX_MAX_AMOUNT=5000
# Exige que o dono da chave no DICT seja o CPF do freelancer cadastrado.
SICOOB_PIX_VALIDAR_TITULAR=true

# Enviar o header `client_id` nas chamadas de Pix. A spec da Conta Corrente
# exige esse header; a de Pix Pagamentos não o declara. Só mexa aqui se o
# gateway devolver 401 "Invalid client id or secret" no Pix enquanto a Conta
# Corrente funciona — diagnostique com: php artisan sicoob:testar --headers
SICOOB_PIX_ENVIAR_CLIENT_ID=true

# Chave Pix da conta pagadora — só para auditoria, não vai no payload.
SICOOB_PIX_CHAVE_ORIGEM=

# Conta de origem. Em produção é opcional (o Sicoob usa a conta do
# certificado); preencha se a sua cooperativa exigir.
SICOOB_ORIGEM_ISPB=
SICOOB_ORIGEM_CPF_CNPJ=
SICOOB_ORIGEM_NOME=
SICOOB_ORIGEM_AGENCIA=
SICOOB_ORIGEM_CONTA=
SICOOB_ORIGEM_TIPO=CORRENTE

# Pré-checagem de saldo via API Conta Corrente antes de confirmar o Pix.
SICOOB_SALDO_CHECK_ENABLED=true
SICOOB_CC_BASE_URL=https://api.sicoob.com.br/conta-corrente/v4
SICOOB_CC_NUMERO_CONTA=


# ---------------------------------------------------------------------------
# Questor (FUNCSIDERURG) — autorização de Ordem de Compra
# ---------------------------------------------------------------------------
# Servidor e login próprios do ERP de compras. O login do banco só precisa de
# SELECT enquanto QUESTOR_DRY_RUN=true, que é o padrão: nessa condição o
# "aprovar/reprovar" apenas simula a gravação e nada é escrito no Questor.
DB_QUESTOR_HOST=
DB_QUESTOR_PORT=1433
DB_QUESTOR_DATABASE=FUNCSIDERURG
DB_QUESTOR_USERNAME=
DB_QUESTOR_PASSWORD=

QUESTOR_ENABLED=false
QUESTOR_DRY_RUN=true
# CD_CODUSUARIO do usuário técnico da Lara no Questor (criar pela tela do ERP,
# com X_ATIVO, X_AUTORIZA_ORDEM_COMPRA e X_REPROVA_ORDEM_COMPRA = 1).
QUESTOR_USUARIO_TECNICO=
# Escopo da fila: filiais (CD_FILIAL separados por vírgula) e data de corte
# (Y-m-d) para não abrir a tela com o passivo histórico inteiro.
QUESTOR_FILIAIS=
QUESTOR_ORDENS_DESDE=

# Reprovação tem trava própria: o comportamento dela no Questor não foi
# observado ao vivo (seção 6.2 da especificação). Desligada, ela só simula.
QUESTOR_REPROVACAO_LIBERADA=false

# --- Mapa de cotação -------------------------------------------------------
# CD_STATUS de NF de entrada CANCELADA. Não tem FK no Questor e não dá para
# deduzir: rode `php artisan cotacao:descobrir-config` e copie o valor daqui.
# Vazio = nenhuma nota é descartada por status (padrão deliberado — chutar o
# código esconderia compras boas do histórico em silêncio).
QUESTOR_STATUS_NF_CANCELADA=
# 1 = a última compra só conta se veio da mesma filial da solicitação.
QUESTOR_COTACAO_MESMA_FILIAL=false
QUESTOR_COTACAO_MESES_HISTORICO=24
QUESTOR_COTACAO_LIMITE_HISTORICO=20
# Cache dos fornecedores históricos, em segundos (0 desliga).
QUESTOR_COTACAO_CACHE_TTL=900
# Teto de colunas de fornecedor por mapa (o XLSX modelo vai de E até N).
QUESTOR_COTACAO_MAX_FORNECEDORES=10

# --- Replay (vídeos das quadras) ------------------------------------------
# Site de locação de espaços, para onde o e-mail do sócio aponta. O aviso
# nunca leva o vídeo nem link direto: leva ao login do portal.
REPLAY_PORTAL_URL=https://locacao.clubedosfuncionarios.com.br
# Só é usado para compor o overlay ANIMADO (GIF -> WebM com canal alpha).
# Sem ffmpeg instalado, a API entrega só o PNG e o módulo segue funcionando.
REPLAY_FFMPEG_PATH=ffmpeg

# --- Assinatura eletrônica presencial (tablet do balcão) --------------------
# Disco onde ficam PDFs, traços e fotos. PRIVADO, sempre: nada disso vira URL.
# Não aponte para `public` nem `placar`, que servem arquivo estático sem
# passar por autorização.
SIGNATURE_DISK=local

# Prazo do QR Code exibido pelo atendente, em segundos. Curto de propósito: é
# o tempo entre mostrar o código e o tablet lê-lo, e um QR que fica valendo é
# um QR que alguém fotografa.
SIGNATURE_QR_TTL_SECONDS=300
# Prazo da sessão que nasce da leitura — cobre ler, conferir CPF e assinar.
SIGNATURE_SESSION_TTL_MINUTES=15
# Quantos segundos antes do fim o tablet avisa.
SIGNATURE_SESSION_WARNING_SECONDS=60
# Prazo do documento congelado que ninguém assinou (o `signature:expire`
# encerra depois disso).
SIGNATURE_DOCUMENT_TTL_HOURS=24

# --- Modo sem HTTPS (caminho degradado) ---
# getUserMedia só funciona em origem segura: em HTTP comum o tablet não lê QR e
# não tira foto. As duas flags abaixo tornam esse cenário operável — e nascem
# DESLIGADAS, porque cada uma abre mão de alguma coisa.
#
# Código curto ditado pelo atendente e digitado no tablet, ao lado do QR.
# Mesmas travas (uso único, vínculo com um documento, faixa de IP); vida mais
# curta, porque um código ditado em voz alta é ouvido por quem está na fila.
SIGNATURE_MANUAL_CODE_ENABLED=false
SIGNATURE_MANUAL_CODE_TTL_SECONDS=150
#
# Concluir a assinatura sem a foto quando o aparelho não tem câmera. A ausência
# é REGISTRADA com o motivo e impressa no manifesto — não é o mesmo que um
# modelo que não pedia foto.
SIGNATURE_SKIP_PHOTO_WITHOUT_CAMERA=false

# Faixas de IP que podem CONSUMIR um QR, em CIDR ou IP solto, separadas por
# vírgula. Vazio = sem restrição. É trava a mais: quem protege é o token de uso
# único. Ex.: 192.168.10.0/24,10.0.0.5
SIGNATURE_ALLOWED_IPS=

# Mínimo de pontos do traço. Abaixo disso não é assinatura, é um toque na tela.
SIGNATURE_MIN_STROKE_POINTS=30
# Mínimo de pontos do visto (rubrica), quando o modelo exige visto em todas as páginas.
SIGNATURE_MIN_INITIALS_POINTS=8

# Cópia do PDF assinado no servidor de arquivos (FTP), em pastas por modelo e
# por pessoa. Desligado por padrão — ligue no servidor. Usa o mesmo FTP das
# variáveis FTP_*; as SIGNATURE_FTP_* abaixo só são necessárias se for outro.
SIGNATURE_ARCHIVE_ENABLED=false
SIGNATURE_ARCHIVE_ROOT=Lara/DocumentosAssinados

# Cópia dos contratos de freelancer assinados (contrato, aditivo e comissão) no
# mesmo servidor de arquivos, na pasta Freelancers, uma pasta por pessoa.
# Desligado por padrão — ligue no servidor. Ao ligar, o histórico de contratos
# assinados é enviado aos poucos, de hora em hora (php artisan freelancers:archive).
FREELANCER_ARCHIVE_ENABLED=false
# SIGNATURE_FTP_HOST=
# SIGNATURE_FTP_PORT=21
# SIGNATURE_FTP_USERNAME=
# SIGNATURE_FTP_PASSWORD=
# SIGNATURE_FTP_SSL=false
SIGNATURE_MAX_SIGNATURE_KB=2048
SIGNATURE_MAX_PHOTO_KB=4096

# Prazo de guarda padrão, em meses, para modelos que não definem o seu.
# A EXCLUSÃO AUTOMÁTICA NÃO ESTÁ IMPLEMENTADA — o campo registra a decisão.
SIGNATURE_RETENTION_MONTHS=60

# Envio da via ao signatário. O WhatsApp nasce desligado: o gateway da Poli
# responde 200 para envios que não entrega, e gravar "enviado" com base nisso
# colocaria informação falsa na trilha de auditoria.
SIGNATURE_DELIVERY_EMAIL=true
SIGNATURE_DELIVERY_WHATSAPP=false

# Assinatura pelo gov.br: tamanho máximo (KB) do PDF assinado que o atendente
# envia na aba "Assinatura gov.br" do documento. A cadeia de confiança fica no
# repositório (resources/certs/govbr) — não há variável de ambiente para ela.
SIGNATURE_GOVBR_MAX_UPLOAD_KB=20480
# Prazo, em dias, do documento preparado para o gov.br (o do balcão é de horas,
# SIGNATURE_DOCUMENT_TTL_HOURS). Vencido, o `signature:expire` encerra o documento.
SIGNATURE_GOVBR_TTL_DAYS=7

# Tamanho máximo, em KB, de cada anexo do documento (identidade, comprovante),
# enviado pelo atendente na tela do documento. PDF, JPG ou PNG.
SIGNATURE_ATTACHMENT_MAX_KB=10240

# Validade, em minutos, do código de 6 números da conferência de identidade
# "Código enviado por e-mail" (opção do modelo), digitado no tablet.
SIGNATURE_IDENTITY_CODE_TTL_MINUTES=10

# Termo de Menores (tablet de autoatendimento dos eventos): horas que o tablet
# fica pareado, segundos de validade do QR de pareamento, minutos de
# inatividade que encerram o atendimento e tentativas de CPF por título.
SIGNATURE_MINOR_DEVICE_TTL_HOURS=12
SIGNATURE_MINOR_PAIRING_TTL_SECONDS=300
SIGNATURE_MINOR_FLOW_TTL_MINUTES=10
SIGNATURE_MINOR_MAX_CPF_ATTEMPTS=5

# Lacre do PDF final com certificado A1 (PAdES). NÃO IMPLEMENTADO: ligar sem
# implementar falha alto, de propósito.
SIGNATURE_PADES_ENABLED=false
SIGNATURE_PADES_CERTIFICATE=
SIGNATURE_PADES_PASSWORD=
