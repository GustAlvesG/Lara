APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

API_TOKEN=#API_TOKEN#

JWT_SECRET=#JWT_SECRET#

WHATSAPP_API_URL=#
WHATSAPP_PHONE_ID=#
WHATSAPP_TOKEN=#
WHATSAPP_VERIFY_TOKEN=#

# Lara — agente de IA interno. Sem LARA_BASE_URL o chat aparece desativado,
# então dá pra subir o código em produção antes de o endereço estar liberado.
# O endereço da VM não vai para o repositório: preencher só no .env do servidor.
LARA_ENABLED=false
LARA_BASE_URL=
LARA_TIMEOUT=60

# Diretoria dos contratos de freelancer: recebe por e-mail os dois PINs
# (um aprova, outro recusa) de cada lote aprovado pela gerência.
FREELANCER_DIRECTOR_NAME="Diretoria"
FREELANCER_DIRECTOR_EMAIL=
FREELANCER_DIRECTOR_CC=

# ---------------------------------------------------------------------------
# Sicoob — Pix Pagamentos (ENVIA DINHEIRO REAL)
#
# Com SICOOB_PIX_ENABLED=false o "Dar baixa" do financeiro continua sendo uma
# marcação manual, sem tocar no banco. Ligue só depois de conferir todo o
# restante. Guia completo: docs/funcionalidades/pix-sicoob.md
#
# NUNCA preencha valores reais aqui — este arquivo vai para o repositório.
# ---------------------------------------------------------------------------
SICOOB_PIX_ENABLED=false
SICOOB_ENVIRONMENT=sandbox
SICOOB_CLIENT_ID=

# Certificado ICP Brasil em PEM (converta o .pfx uma vez; ver documentação).
# Os arquivos ficam em storage/certificates/, que está no .gitignore.
SICOOB_CERT_PATH=
SICOOB_CERT_KEY_PATH=
SICOOB_CERT_KEY_PASSWORD=

# Sandbox: https://sandbox.sicoob.com.br/sicoob/sandbox/pix-pagamentos/v2
# Produção: https://api.sicoob.com.br/pix-pagamentos/v2
SICOOB_PIX_BASE_URL=https://sandbox.sicoob.com.br/sicoob/sandbox/pix-pagamentos/v2
SICOOB_TOKEN_URL=https://auth.sicoob.com.br/auth/realms/cooperado/protocol/openid-connect/token

# Teto por transferência, em reais. Última barreira antes de o dinheiro sair.
SICOOB_PIX_MAX_AMOUNT=5000
# Exige que o dono da chave no DICT seja o CPF do freelancer cadastrado.
SICOOB_PIX_VALIDAR_TITULAR=true

# Enviar o header `client_id` nas chamadas de Pix. A spec da Conta Corrente
# exige esse header; a de Pix Pagamentos não o declara. Só mexa aqui se o
# gateway devolver 401 "Invalid client id or secret" no Pix enquanto a Conta
# Corrente funciona — diagnostique com: php artisan sicoob:testar --headers
SICOOB_PIX_ENVIAR_CLIENT_ID=true

# Chave Pix da conta pagadora — só para auditoria, não vai no payload.
SICOOB_PIX_CHAVE_ORIGEM=

# Conta de origem. Em produção é opcional (o Sicoob usa a conta do
# certificado); preencha se a sua cooperativa exigir.
SICOOB_ORIGEM_ISPB=
SICOOB_ORIGEM_CPF_CNPJ=
SICOOB_ORIGEM_NOME=
SICOOB_ORIGEM_AGENCIA=
SICOOB_ORIGEM_CONTA=
SICOOB_ORIGEM_TIPO=CORRENTE

# Pré-checagem de saldo via API Conta Corrente antes de confirmar o Pix.
SICOOB_SALDO_CHECK_ENABLED=true
SICOOB_CC_BASE_URL=https://api.sicoob.com.br/conta-corrente/v4
SICOOB_CC_NUMERO_CONTA=
