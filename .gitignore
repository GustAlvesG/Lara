.phpunit.cache
node_modules
public/build
public/hot
public/storage
storage/*.key
vendor
.env
.env.backup
.env.production
.phpunit.result.cache
Homestead.json
Homestead.yaml
auth.json
npm-debug.log
yarn-error.log
/.fleet
/.idea
/.vscode
*.sql
# Exceção: consultas de REFERÊNCIA versionadas (não são dump, não têm dado).
# O código do mapa de cotação cita estas queries pelo número em vários
# comentários — sem o arquivo no repositório, a referência não resolve.
!docs/sql/*.sql

# Certificados ICP Brasil da integração Sicoob (mTLS). Vazar o par
# certificado+chave é entregar a capacidade de MOVER DINHEIRO da conta.
storage/certificates
*.pfx
*.p12
*.pem
*.key
*.crt
# Exceção: a cadeia PÚBLICA do gov.br (só certificados de AC, nenhuma chave).
# Sem ela no repositório, a conferência de assinatura gov.br recusa tudo.
!resources/certs/govbr/cadeia-govbr.pem
# Idem: as raízes PÚBLICAS da ICP-Brasil (assinatura qualificada na mesma aba).
!resources/certs/icp-brasil/raizes-icp-brasil.pem